meta {
  name: 13 - Crear zona (solo admin)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/zonas
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "nombre": "Zona de prueba Bruno",
    "lat": 17.05,
    "lng": -96.70
  }
}

assert {
  res.status: eq 201
}