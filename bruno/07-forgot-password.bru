meta {
  name: 07 - Forgot password
  type: http
  seq: 7
}

post {
  url: {{base_url}}/auth/forgot-password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@rastropet.com"
  }
}

assert {
  res.status: eq 200
}