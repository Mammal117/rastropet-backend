meta {
  name: 01 - Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@rastropet.com",
    "password": "Admin123!"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
}